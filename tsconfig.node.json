{
  "compilerOptions": {
    "composite": true,
    // 产物输出到 node_modules/.tmp，避免 vite.config.js / .d.ts 污染仓库根目录
    "outDir": "./node_modules/.tmp/tsconfig.node",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["vite.config.ts"]
}
